# API response cache (hard rule 3) — contents never committed
cache/*
!cache/.gitkeep

# Experiment outputs
results/*
!results/.gitkeep

# Model weights / artifacts
*.onnx
*.safetensors
*.gguf
*.bin
*.pt
*.ckpt
/checkpoints/
/adapters/
/models/

# Data. Anchored to the repo root with a leading slash: a bare `data/` also matches
# src/data/ and would silently exclude the entire data layer from git.
# Manifests under configs/ ARE committed — they are the frozen evaluation sets.
/data/
*.jsonl
*.parquet
*.arrow

# The spend ledger IS a result and must be committed — it is the record of real money
# actually spent (hard rule 12). This negation MUST stay below `results/*` AND below
# `*.jsonl`: git applies the LAST matching pattern, so a negation placed above the rule
# it overrides does nothing. It sat above `*.jsonl` and the ledger was never tracked.
# Verify with: git ls-files --error-unmatch results/spend_ledger.jsonl
# (NOT `git check-ignore -v` -- that prints the matching pattern even when the
#  match is a negation, so it looks identical whether the file is tracked or not.)
!results/spend_ledger.jsonl

# Secrets
.env
.env.*
!.env.example
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# HF / MLX caches
.cache/
.huggingface/

# OS / editor
.DS_Store
.idea/
.vscode/

# Deploy staging dirs — copies of the 715MB artefact, rebuilt by the upload scripts.
/deploy/_model_upload/
/deploy/_space_upload/

# ---------------------------------------------------------------------------------
# SMALL RESULT SUMMARIES REPORT.md CITES. Tracked so a reader can check any number in
# the report without rerunning anything. These negations MUST stay below `results/*`:
# git applies the LAST matching pattern. Raw logits (.npz), the API response dumps and
# every model artefact stay ignored — they are large and reproducible.
!results/cost_per_1k.json
!results/isa_matrix.json
!results/stage1_scored_test3000.json
!results/served_config_escalation.json
!results/fp32_local_onnx_ce10ep_seed1.json
!results/int8_local_seed?.json
!results/int8_local_ce10ep_seed?.json
!results/int8_local_hostB_seed1.json
!results/tier0_ce_seed?.json
!results/tier1_seed1.json
!results/c2_c4.json
!results/e5_sweep_fp32_aggregate.json
!results/e5_sweep_int8_aggregate.json
!results/e6_frontier.json
!results/e6_cascade_paired.json
!results/bench_*.json
!results/ood_probe.json
